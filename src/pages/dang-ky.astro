<script define:vars={{ SIGNUP_URL, CAP }}>
  // the lines drawn in: each row's, the lowest first, as the row comes into view (not under reduced
  // motion); from when the title starts going up ('signup-lines', below), or at once if that never comes
  // (a sheet shown later, the done one, is made ready the same way and drawn in when it comes into view)
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hostsOf = row => row.matches('.send') ? [row] : [...row.querySelectorAll('.rl')].filter(r => r.offsetParent);
  const draw = row => hostsOf(row).sort((a, b) => b.getBoundingClientRect().bottom - a.getBoundingClientRect().bottom)
    .forEach((h, i) => { h.style.setProperty('--wait', `${(i * .06).toFixed(2)}s`); h.classList.remove('off'); });
  const io = still ? null : new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { io.unobserve(e.target); draw(e.target); } }), { rootMargin: '0px 0px -20% 0px' });
  let started = false;
  const drawIn = row => { if (still) return; hostsOf(row).forEach(h => h.classList.add('off')); if (started) io.observe(row); };
  if (!still) {
    const rows = [...document.querySelectorAll('.sheet, .send')];
    rows.forEach(r => hostsOf(r).forEach(h => h.classList.add('off')));
    const start = () => { if (started) return; started = true; rows.forEach(r => io.observe(r)); };
    document.addEventListener('signup-lines', start, { once: true });
    setTimeout(start, 4000);
  }
  const $ = s => document.querySelector(s);
  const form = $('[data-form]'), send = $('[data-send]'), status = $('[data-status]'), done = $('[data-done]');
  const pay = $('.sheet.pay'), h1 = $('.signup-title');
  // the QR's frame says so while the image is not there yet
  const qr = $('[data-qr]');
  const noQr = () => { qr.hidden = true; $('[data-qr-none]').hidden = false; };
  if (qr.complete && !qr.naturalWidth) noQr(); else qr.addEventListener('error', noQr);

  const say = (text, kind = '') => { status.textContent = text; status.className = `status ${kind}`; };
  // the places left (paid and waiting to pay both taken)
  const show = d => {
    const paid = Math.max(0, d.paid ?? d.taken ?? 0), wait = Math.max(0, d.wait ?? 0), left = Math.max(0, CAP - paid - wait);
    $('[data-left]').textContent = `(${String(left).padStart(2, '0')})`;
    return left;
  };
  // the page once signed up or full (Figma's Reserved, Confirmed and Fully booked): the title in its own
  // words (its lines Neue World, Migra, Neue World, as the page's own), the form put away and the done
  // sheet in its place, what it means on the left and its state on the right; the payment's QR and price
  // on it while it is still to pay, the weathervane once it is settled. The title's ice is made again for
  // its new words ('retitle', the script at the foot)
  const WORDS = { reserved: ['You’ve', 'reserved', 'a slot'], confirmed: ['You’re', 'in the game'], full: ['fully', 'booked'] };
  const setState = (kind, m = {}) => {
    form.querySelectorAll('input, textarea, button').forEach(el => { el.disabled = true; });
    for (const s of [$('.sheet.info'), pay, send.parentElement]) s.hidden = true;
    if (document.body.dataset.state !== kind) {
      document.body.dataset.state = kind;
      h1.replaceChildren(...WORDS[kind].map((w, i) => Object.assign(document.createElement('span'), { className: i % 2 ? 'line serif' : 'line', textContent: w })));
      h1.dispatchEvent(new Event('retitle'));
    }
    const note = $('[data-done-note]'), mark = t => `<span class="serif">${t}</span>`;
    if (kind === 'reserved') {
      $('[data-done-text]').textContent = `Thank you, ${m.name}. Transfer 5.000.000đ with the QR below, with your Discord nick (${m.discord || 'your Discord nick'}) as the transfer`;
      note.innerHTML = `${mark('(*)')} note.<br>Once it arrives, this page will confirm your place.`;
    } else if (kind === 'confirmed') {
      $('[data-done-text]').textContent = `Welcome to the first season, ${m.name}. Your transfer has arrived and your place is confirmed. See you on the class Discord.`;
      note.innerHTML = `${mark('Status')}<br>confirmed`;
    } else {
      $('[data-done-text]').textContent = `All ${CAP} places of the first season are taken. Follow the Discord to hear when the next class opens.`;
      note.innerHTML = `${mark('Status')}<br>closed`;
    }
    $('[data-done-pay]').hidden = kind !== 'reserved';
    $('[data-vane]').hidden = kind === 'reserved';
    if (done.hidden) { done.hidden = false; drawIn(done); }
  };
  const full = () => setState('full');

  // the sign-up made on this browser: its code, kept so the page can say how it stands when it is opened again
  const KEY = 'vsc-signup';
  let mine = null;
  try { mine = JSON.parse(localStorage.getItem(KEY) || 'null'); } catch {}
  const forget = () => { mine = null; try { localStorage.removeItem(KEY); } catch {} };
  const remember = m => { mine = m; try { localStorage.setItem(KEY, JSON.stringify(m)); } catch {} };
  let polling = 0;
  const view = st => {
    if (st === 'paid') { clearInterval(polling); setState('confirmed', mine); }
    else {
      setState('reserved', mine);
      // (asked again every 20 s while the page is in view)
      if (!polling) polling = setInterval(() => { if (!document.hidden) ask(); }, 20000);
    }
  };
  // the places, and how this browser's sign-up stands
  const ask = () => fetch(mine ? `${SIGNUP_URL}?code=${encodeURIComponent(mine.code)}` : SIGNUP_URL).then(r => r.json()).then(d => {
    show(d);
    if (mine && (d.status === 'wait' || d.status === 'paid')) return view(d.status);
    if (mine && (d.status === 'drop' || d.status === 'none')) {
      const dropped = d.status === 'drop';
      forget(); clearInterval(polling); polling = 0;
      if (dropped) say('Đăng ký trước của bạn đã được huỷ. Bạn có thể đăng ký lại.', 'bad');
    }
    if (!mine && CAP - (d.paid ?? 0) - (d.wait ?? 0) <= 0 && done.hidden) full();
  }).catch(() => {}).finally(() => document.dispatchEvent(new Event('signup-state')));


  if (!SIGNUP_URL) {
    send.disabled = true;
    say('Form sắp mở. Trong lúc chờ, nhắn thầy qua Discord để giữ chỗ.');
    document.dispatchEvent(new Event('signup-state'));
  } else ask();

  form.addEventListener('submit', async e => {
    e.preventDefault();
    if (!SIGNUP_URL) return;
    const data = Object.fromEntries(new FormData(form));
    let bad = null;
    for (const name of ['name', 'discord', 'wish']) {
      const el = form.elements[name], empty = !String(data[name] || '').trim();
      el.setAttribute('aria-invalid', String(empty));
      if (empty && !bad) bad = el;
    }
    if (bad) { bad.focus(); say('Điền đủ tên, nick Discord và mong muốn của bạn nhé.', 'bad'); return; }
    send.disabled = true; say('Đang gửi…');
    try {
      // (text/plain, so the browser sends it straight, with no preflight the script would not answer)
      const r = await fetch(SIGNUP_URL, { method: 'POST', headers: { 'Content-Type': 'text/plain;charset=utf-8' }, body: JSON.stringify(data) });
      const d = await r.json();
      if (d.ok) {
        show(d);
        window.va?.('event', { name: 'signup' });
        // (the sheet's older script gives no code: thanked all the same, the payment kept in view)
        if (d.code) { remember({ code: d.code, name: data.name.trim(), discord: data.discord.trim() }); view('wait'); }
        else setState('reserved', { name: data.name.trim(), discord: data.discord.trim() });
      } else if (d.error === 'full') { show(d); full(); }
      else if (d.error === 'dup') { send.disabled = false; say('Nick Discord này đã đăng ký rồi. Nếu là nhầm lẫn, nhắn thầy qua Discord.', 'bad'); }
      else { send.disabled = false; say('Thiếu thông tin, kiểm tra lại các ô nhé.', 'bad'); }
    } catch {
      send.disabled = false; say('Chưa gửi được. Thử lại sau ít phút, hoặc nhắn thầy qua Discord.', 'bad');
    }
  });
</script>
<script>
  // the title's entrance, as the hero's (motion.js intro): set in the screen's middle, its lines go up to
  // their places one after another (1.8 s, expo.inOut, .12 apart) while the rest of the page comes in;
  // once they are at rest the ice takes them over, growing in from the foot (title-shader.js, on 'risen')
  import { gsap } from 'gsap';
  // the footer, the landing page's own (src/partials/foot.html): its clip dithered, its ring of work, its
  // rules round its type and its links that open out
  import '../scripts/dither.js';
  import '../scripts/ring.js';
  import { footRules, socials } from '../scripts/rules.js';
  const root = document.documentElement, h1 = document.querySelector('.signup-title');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  // the page's state first (the sign-up script says when it knows it, 'signup-state'; a second and a half
  // at most), so the title comes in in its own words and its ice is made for them (title-shader.js, which
  // reads the titles' letters as it comes in); its words changed later ('retitle'), the ice made again,
  // and the footer's rules laid again where its title now stands
  const settled = new Promise(r => { document.addEventListener('signup-state', r, { once: true }); setTimeout(r, 1500); });
  const shader = settled.then(() => import('../scripts/title-shader.js'));
  h1.addEventListener('retitle', () => {
    if (h1.classList.contains('risen')) shader.then(m => m.reshade(h1));
    requestAnimationFrame(() => { footRules(); iced(); });
  });
  // once settled or full, the landing page's rooster in its ice where the weathervane stands (rooster.js;
  // the weathervane's picture where there is no WebGL)
  let roosted = false;
  const iced = () => {
    const vane = document.querySelector('[data-vane]');
    if (roosted || !['confirmed', 'full'].includes(document.body.dataset.state) || !vane?.offsetParent) return;
    roosted = true;
    import('../scripts/rooster.js').then(m => m.rooster(vane));
  };
  settled.then(() => requestAnimationFrame(iced));

  // the footer as the landing page sets it: its title in ice at once (title-shader.js, on 'risen'), its
  // rules laid round its type and drawn in as it comes into view (from both ends to the middle, the
  // lowest first, as all the rules are), laid again on a resize; its links opening out on hover
  const SIDES = a => `polygon(0% 0%, ${a}% 0%, ${a}% 100%, ${100 - a}% 100%, ${100 - a}% 0%, 100% 0%, 100% 100%, 0% 100%)`;
  // (once the page's state is known: the footer comes up under a done sheet, and its rules are counted from its title)
  Promise.all([document.fonts.ready, settled]).then(async () => {
    const fh = document.querySelector('.foot h2');
    fh?.classList.add('risen'); fh?.dispatchEvent(new Event('risen'));
    socials();
    const laid = await footRules();
    if (!reduce && laid.length) {
      const order = [...laid].sort((a, b) => b.getBoundingClientRect().top - a.getBoundingClientRect().top);
      gsap.set(order, { clipPath: SIDES(0) });
      const io = new IntersectionObserver(([e]) => {
        if (!e.isIntersecting) return;
        io.disconnect();
        gsap.to(order, { clipPath: SIDES(50), duration: .9, ease: 'expo.inOut', stagger: Math.min(.06, 1.2 / order.length), clearProps: 'clipPath' });
      }, { rootMargin: '0px 0px -25% 0px' });
      io.observe(document.querySelector('.foot'));
    }
    let t = 0;
    addEventListener('resize', () => { cancelAnimationFrame(t); t = requestAnimationFrame(() => footRules()); });
  });
  const risen = () => {
    h1.querySelectorAll('.line').forEach(l => { l.style.transform = ''; }); h1.classList.add('risen'); h1.dispatchEvent(new Event('risen'));
    // (its words changed while it came in, the state coming late: the new lines shaded after the old)
    setTimeout(() => shader.then(m => m.shadeNew(h1)));
  };
  if (reduce) shader.then(risen);
  else Promise.all([document.fonts.ready, shader]).then(() => {
    // (the title's lines and the rest as they are once the state is known; the footer is not held back:
    // far under the fold, and its title's ice reads its letters as it is set)
    const lines = [...h1.querySelectorAll('.line')], rest = [...document.querySelectorAll('.page > *')].filter(e => e !== h1);
    const r = h1.getBoundingClientRect(), y = innerHeight / 2 - (r.top + r.height / 2);
    gsap.set(lines, { y }); gsap.set(rest, { autoAlpha: 0 });
    root.classList.remove('intro');
    const HOLD = .35;
    gsap.to(lines, { y: 0, duration: 1.8, ease: 'expo.inOut', stagger: .12, delay: HOLD, onComplete: risen });
    gsap.to(rest, { autoAlpha: 1, duration: .8, ease: 'power2.out', stagger: .04, delay: HOLD + 1.15, clearProps: 'opacity,visibility',
      onStart: () => document.dispatchEvent(new Event('signup-lines')) });
    // (where no frame is drawn, the entrance never runs: the page set out all the same, the title in place,
    // the form, the QR and the rest shown, after twice the entrance's time)
    setTimeout(() => {
      if (h1.classList.contains('risen')) return;
      gsap.killTweensOf([...lines, ...rest]);
      gsap.set(rest, { clearProps: 'opacity,visibility' });
      document.dispatchEvent(new Event('signup-lines'));
      risen();
    }, 4500);
  });
</script>
