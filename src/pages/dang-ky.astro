---
// The sign-up page: a place in the first season, nine at most. A sign-up waits for its transfer
// (its own code, VSC and four letters, to write as the transfer's content) till the sheet's owner sets it
// to "Đã nhận tiền"; the page, remembering the code, then says the place is confirmed. The places:
// filled, paid; hatched, waiting to pay; empty, free. The form is sent to a Google Sheet by
// its Apps Script web app (tools/signup-apps-script.gs: one row a sign-up, the ninth the last, a lock
// so two at once never make a tenth), whose address is SIGNUP_URL (src/signup.js); the page asks it how
// many places are taken as it opens. Set as the landing page is: black, the magenta, PP Neue World
// and Migra for the title, ABC Areal for the small type on hairline rules. The bank's QR code is
// public/pay/vpbank-qr.png (the VPBank VietQR, cut from the bank app; a frame says so if it is missing). Laid as
// Figma's "Sign up / Desktop / Open" (The Visualizers Club, Website): on the landing page's grid, the
// title centred as the hero's, then the form as one sheet of ruled paper across the page
import '../styles/landing.css';   // (the landing page's styles: its footer, shared, is set by them)
import foot from '../partials/foot.html?raw';
import { SIGNUP_URL, CAP } from '../signup.js';   // the sheet's web app (…/exec) and the places
---
<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Sign up · The Visualizers Club</title>
<meta name="description" content="Đăng ký giữ chỗ cho mùa đầu tiên của The Visualizers Club: 9 chỗ, 5.000.000đ.">
<meta name="theme-color" content="#000000">
<link rel="canonical" href="https://visualizers.lavidesign.studio/dang-ky">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<meta property="og:type" content="website">
<meta property="og:site_name" content="The Visualizers Club">
<meta property="og:locale" content="vi_VN">
<meta property="og:url" content="https://visualizers.lavidesign.studio/dang-ky">
<meta property="og:title" content="Sign up · The Visualizers Club">
<meta property="og:description" content="9 chỗ cho mùa đầu tiên. Điền tên, nick Discord và điều bạn muốn có sau khoá học.">
<meta property="og:image" content="https://visualizers.lavidesign.studio/og.jpg">
<meta name="twitter:card" content="summary_large_image">
<link rel="preload" href="/fonts/PPNeueWorld-SemiExtendedUltralight.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/PPMigra-ExtralightItalic.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/ABCAreal-Regular.woff2" as="font" type="font/woff2" crossorigin>
<script is:inline>window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };</script>
<script is:inline defer src="/_vercel/insights/script.js"></script>
<script is:inline>
  // the title comes in as the landing page's hero title does (the script at the foot): the page held
  // hidden till it is set in the screen's middle, and shown anyway if that never comes
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.documentElement.classList.add('intro');
    setTimeout(() => document.documentElement.classList.remove('intro'), 4000);
  }
</script>
<style is:global>
@font-face { font-family: "PP Neue World"; src: url(/fonts/PPNeueWorld-SemiExtendedUltralight.woff2) format("woff2"); font-weight: 200; font-display: swap; }
@font-face { font-family: "PP Migra"; src: url(/fonts/PPMigra-ExtralightItalic.woff2) format("woff2"); font-weight: 200; font-style: italic; font-display: swap; }
@font-face { font-family: "ABC Areal"; src: url(/fonts/ABCAreal-Regular.woff2) format("woff2"); font-weight: 400; font-display: swap; }
@font-face { font-family: "ABC Areal"; src: url(/fonts/ABCAreal-Medium.woff2) format("woff2"); font-weight: 500; font-display: swap; }
:root { --ground: #000; --magenta: #c239c7; color-scheme: dark; }
* { box-sizing: border-box; }
html { background: var(--ground); scrollbar-gutter: stable; }
body {
  margin: 0; background: var(--ground); color: var(--magenta);
  font: 400 16px/1 "ABC Areal", system-ui, sans-serif; text-transform: uppercase;
  overflow-x: clip; -webkit-font-smoothing: antialiased;
}
h1, h2, p, ol, ul, dl, dd, figure { margin: 0; padding: 0; font: inherit; }
ol, ul { list-style: none; }
a { color: inherit; text-underline-position: from-font; }
:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
[hidden] { display: none !important; }
.sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
.serif { font-family: "PP Migra", serif; font-style: italic; font-weight: 200; letter-spacing: -.01em; }
.display { font-family: "PP Neue World", serif; font-weight: 200; line-height: 1; }
/* text sits on its caps, as the landing page trims it (Figma's) */
main :is(h1, h2, p, li, dt, dd, label, .line, .cap) { text-box: trim-both cap alphabetic; }

/* the landing page's grid and its sizes (landing.css): 1728 wide, 12 columns, 16 margins and gutters,
   every length in --px; the small type 20, the titles 160 (the hero's, smaller where the screen is
   short for it), the larger small type 40 */
main { container-type: inline-size; }
.page {
  --px: calc(100cqi / 1728); --tpx: min(100cqi / 1728, 100svh / 1117);
  --gap: calc(16 * var(--px));
  --f16: max(11px, calc(16 * var(--px)));
  --f20: max(12px, calc(20 * var(--px)));
  --f40: max(20px, calc(40 * var(--px)));
  --f160: calc(160 * var(--tpx));
  display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gap);
  padding: 0 var(--gap) max(var(--gap), env(safe-area-inset-bottom, 0px)); align-content: start; position: relative;
}
/* the hero's bar: its corners 21 down */
.bar { position: absolute; top: calc(21 * var(--px)); left: var(--gap); right: var(--gap); display: flex; justify-content: space-between; font-size: var(--f16); letter-spacing: -.02em; }
.bar a { position: relative; }
.bar a::before { content: ""; position: absolute; inset: -8px; }
/* the title as the hero's: centred on the page, 16 between its lines (columns 2 to 11: its Migra line
   is wider than the hero's 4 to 9), each line whole */
.title { grid-column: 2 / span 10; white-space: nowrap; margin-top: calc(21 * var(--px) + 64px); font-size: var(--f160); display: flex; flex-direction: column; gap: .15em; text-align: center; letter-spacing: 0; }   /* (24 between its lines at 160, as Figma's) */
.title .serif { letter-spacing: -.01em; }

/* the form as ruled paper across the whole page (Figma's "Sign up / Desktop / Open"): hairlines from
   edge to edge, a line apart, and everything on them set in the middle of its line. Two sheets: what you
   write, its lines 50 apart, and the payment, 58 apart (so the price's caps fill two). On the first: the
   places left, as a big number (columns 2-4), the step's name (columns 5-7, its number hanging in the
   gutter before it, as the fields' A. B. C.), and the fields, a name on one line and what you write on
   the next (columns 8 on). On the second: the step's name, the QR over five lines (columns 8-9), the
   price over two (column 7 on), and "ưu đãi cho mùa đầu tiên" on the line under it. Then "sign up",
   large, as the button, and under it what the page has to say.
   Each line is its own element (.rl, a row of the sheet's grid: its foot is the line), so the lines are
   drawn in one after another, the lowest first, from both ends to the middle (--d, 0 to 50, as every
   rule on the site), as the sheet comes into view (the script below). A thing on the sheet sits in
   rows --r to --r + --s (on a phone, --mr and --ms) */
@property --d { syntax: '<number>'; inherits: true; initial-value: 50; }
.sheet, .send { transition: --d .9s cubic-bezier(.87, 0, .13, 1) var(--wait, 0s); }
.rl { transition: --d .9s cubic-bezier(.87, 0, .13, 1) var(--wait, 0s); }
.off { --d: 0; }
.sheet {
  --line: max(40px, calc(50 * var(--px)));
  grid-column: 1 / -1; display: grid; grid-template-columns: subgrid; grid-auto-rows: var(--line);
  position: relative; isolation: isolate;
}
.sheet.info { margin-top: calc(42 * var(--px)); }   /* (the first line 369 down, as Figma's) */
.sheet.pay { --line: max(46px, calc(58 * var(--px))); }
.sheet > *, .fields > * { grid-row: var(--r) / span var(--s, 1); align-self: center; min-width: 0; }
.rl {
  grid-column: 1 / -1; align-self: stretch; margin-inline: calc(-1 * var(--gap)); z-index: -1; pointer-events: none;
  border-bottom: 1px solid var(--magenta);
  /* (the clip reaches 2 past the line above and below: its edge never cuts the hairline, which sits
     between pixels where the row does, so it never greys) */
  clip-path: polygon(0% -2px, calc(var(--d) * 1%) -2px, calc(var(--d) * 1%) calc(100% + 2px), calc(100% - var(--d) * 1%) calc(100% + 2px), calc(100% - var(--d) * 1%) -2px, 100% -2px, 100% calc(100% + 2px), 0% calc(100% + 2px));
}
.rl.top { border-top: 1px solid var(--magenta); }
.rl.m { display: none; }   /* (the lines only a phone's longer sheet needs) */

/* the small type: ABC Areal 20, its number in Migra hanging in the gutter before it */
.lab, .field-name { position: relative; font-size: var(--f20); letter-spacing: -.02em; line-height: 1.2; }
.lab .n, .field-name .n { position: absolute; right: calc(100% + var(--gap)); letter-spacing: 0; }
.places-lab { grid-column: 2 / span 3; }
.step-lab { grid-column: 5 / span 3; }
/* the places left: Migra 160, its caps 37 under the second line */
.left { grid-column: 2 / span 3; align-self: start; margin-top: calc(37 * var(--px)); font-size: calc(160 * var(--px)); letter-spacing: -.01em; line-height: 1; white-space: nowrap; }

/* the fields: a name on one line, what you write on the next (the wish on four), the magenta whole, the
   hint at half; where you are writing, its lines a little lit; a field left empty, in the warning pink */
.fields { display: contents; }
.field-name, .info input, .info textarea { grid-column: 8 / -1; }
.info input, .info textarea {
  align-self: stretch; display: block; width: 100%; height: 100%; margin: 0; padding: 0;
  background: transparent; color: var(--magenta); border: 0; border-radius: 0; appearance: none;
  font: 400 var(--f20)/var(--line) "ABC Areal", system-ui, sans-serif; letter-spacing: -.02em; text-transform: uppercase;
  caret-color: var(--magenta); text-box: normal;
}
.info textarea { resize: none; overflow-y: auto; }
.info input::placeholder, .info textarea::placeholder { color: var(--magenta); opacity: .5; }
.info input:focus, .info textarea:focus { outline: none; background-color: rgba(194, 57, 199, .1); }
.info [aria-invalid="true"], .info [aria-invalid="true"]::placeholder { color: #ff4d8d; }
.info [aria-invalid="true"]::placeholder { opacity: .7; }
.field-name:has(+ [aria-invalid="true"]) { color: #ff4d8d; }
.trap { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }

/* once signed up, or the places taken (Figma's "Sign up / Desktop / Reserved", "Confirmed" and "Fully
   booked"): the title says so in its own words (body[data-state], set by the script below), the form is
   put away and a sheet of its own takes its place, its first line 523 down (the title over it, however
   many lines it has), its lines as the frames draw them: 35, 27, 20, five of 24, then fourteen of 36.
   On it, from just under its first line: what it means on the left (columns 1-4), its state on the
   right (columns 10-12, set right, its name in Migra over it); on Confirmed and Fully booked the
   rooster weathervane in the middle, over the lines and past them (/signup/vane.svg, Figma's trace); on
   Reserved the QR (column 8) and the price under it. The footer's title 131 under the last line */
[data-state] .title { min-height: calc(502 * var(--px) - 64px); }
.sheet.done {
  grid-template-rows: calc(35 * var(--px)) calc(27 * var(--px)) calc(20 * var(--px)) repeat(5, calc(24 * var(--px))) repeat(14, calc(36 * var(--px)));
  grid-auto-rows: 0;
}
.done > :not(.rl), .done-pay > * { position: absolute; margin: 0; grid-column: auto; grid-row: auto; }
.done-pay { display: contents; }
.done-left { left: 0; top: calc(15 * var(--px)); width: calc(554 * var(--px)); font-size: var(--f20); letter-spacing: -.02em; line-height: 1.4; }
[data-state="reserved"] .done-left { line-height: 1.2; }
.done-right { right: 0; top: calc(15 * var(--px)); width: calc(411 * var(--px)); text-align: right; font-size: var(--f20); letter-spacing: -.02em; line-height: 1.2; }
.done-right .serif { letter-spacing: 0; }
.vane { left: 50%; translate: -50% 0; top: calc(-50 * var(--px)); width: calc(598 * var(--px)); height: auto; pointer-events: none; }
/* the landing page's rooster in its ice (rooster.js), over the weathervane's place, the picture hidden
   under it once it is drawn */
.done > .rooster { position: absolute; z-index: 1; pointer-events: none; grid-column: auto; grid-row: auto; margin: 0; }
.vane.iced { visibility: hidden; }
[data-state="full"] .vane { top: calc(-79 * var(--px)); }
.done .bank-qr { position: absolute; grid-column: auto; grid-row: auto; left: calc(999 * var(--px)); top: calc(183 * var(--px)); width: calc(267 * var(--px)); height: auto; }
.done .fee { grid-column: auto; grid-row: auto; left: calc(764 * var(--px)); top: calc(462 * var(--px)); }
[data-state="full"] .done-left { width: calc(412 * var(--px)); }
@media (min-width: 900px) { [data-state] .foot { padding-top: calc(131 * var(--px) - var(--gap)); } }   /* (less the page's own 16 under the sheet) */

/* the payment */
.bank-qr { grid-column: 8 / span 2; height: calc(5 * var(--line) - 22 * var(--px)); aspect-ratio: 1; justify-self: start; border: 1px solid var(--magenta); padding: calc(16 * var(--px)); background: #fff; position: relative; }
.bank-qr img { display: block; width: 100%; height: 100%; object-fit: contain; }
.bank-qr .none { position: absolute; inset: 0; display: grid; place-items: center; background: #000; text-align: center; padding: 12px; font-size: var(--f16); line-height: 1.4; text-box: normal; }
.fee { grid-column: 7 / -1; font-size: calc(160 * var(--px)); white-space: nowrap; }   /* (not .price: the landing page's section) */
/* under the price, on the next line, under the QR (column 8) */
.terms { grid-column: 8 / -1; font-size: var(--f20); letter-spacing: -.02em; }
/* what the page has to say about the sending, under the button */
.status { margin-top: calc(40 * var(--px) + 8px); font-size: var(--f20); letter-spacing: -.02em; line-height: 1.4; max-width: 34em; text-box: normal; }
.status:empty { display: none; }
.status.bad { color: #ff4d8d; }

/* the button: "sign up" in Migra 160 from column 6, 48 under the last line, its rule under it. Under the
   pointer (or held, or in focus) its rule goes back to its ends and is drawn in again to the middle, as
   the site's rules are; the arrow steps on */
.send { grid-column: 6 / -1; padding: calc(48 * var(--px)) 0 calc(110 * var(--px)); }
.cta {
  display: inline-flex; padding: 0; margin: 0; background: none; border: 0; color: var(--magenta); cursor: pointer;
  font-size: calc(160 * var(--px)); letter-spacing: -.01em; line-height: 1; text-transform: uppercase; white-space: nowrap;
}
/* (the words on their caps, so the rule is set from the baseline: a button's own box is not trimmed) */
.cta .ct { position: relative; display: inline-block; text-box: trim-both cap alphabetic; }
.cta .ct::after {
  content: ""; position: absolute; left: 0; right: 0; bottom: calc(-10 * var(--px)); height: max(1px, calc(2 * var(--px))); background: currentColor;
  clip-path: polygon(0% 0%, calc(var(--d) * 1%) 0%, calc(var(--d) * 1%) 100%, calc(100% - var(--d) * 1%) 100%, calc(100% - var(--d) * 1%) 0%, 100% 0%, 100% 100%, 0% 100%);
}
.cta .arrow { display: inline-block; transition: translate .5s cubic-bezier(.65, 0, .35, 1); }
@keyframes redraw {
  0% { clip-path: polygon(0% 0%, 50% 0%, 50% 100%, 50% 100%, 50% 0%, 100% 0%, 100% 100%, 0% 100%); }
  40% { clip-path: polygon(0% 0%, 0% 0%, 0% 100%, 100% 100%, 100% 0%, 100% 0%, 100% 100%, 0% 100%); }
  100% { clip-path: polygon(0% 0%, 50% 0%, 50% 100%, 50% 100%, 50% 0%, 100% 0%, 100% 100%, 0% 100%); }
}
@media (hover: hover) { .cta:hover:not(:disabled) .ct::after { animation: redraw .9s cubic-bezier(.87, 0, .13, 1); } .cta:hover:not(:disabled) .arrow { translate: .12em 0; } }
.cta:focus-visible .ct::after, .cta:active .ct::after { animation: redraw .9s cubic-bezier(.87, 0, .13, 1); }
.cta:focus-visible { outline: 1px solid var(--magenta); outline-offset: calc(24 * var(--px)); }
.cta:disabled { opacity: .45; cursor: not-allowed; }

/* a tablet and a phone: the columns stacked (16 margins; the title 80 and 48; the small type 14 and 16),
   the sheets one column, their lines 44 apart: the places' name with its number to the right of it, the
   step's name, each field's name and its line or lines; the payment's name, the QR over six lines, the
   price over two, its offer under it; the button under the sheet, the page's word under that */
@media (max-width: 899px) {
  .page { --gap: 16px; --f16: 12px; --f20: 14px; --f40: 24px; display: flex; flex-direction: column; padding-inline: max(16px, env(safe-area-inset-left, 0px)); }
  .bar { position: static; margin-top: max(16px, env(safe-area-inset-top, 0px)); }
  .title { margin-top: 48px; font-size: 80px; letter-spacing: -.02em; }
  .title .serif { letter-spacing: -.04em; }
  .sheet, .sheet.pay { --line: 44px; grid-template-columns: minmax(0, 1fr); }
  .sheet.info { margin-top: 64px; }
  .page .sheet > *, .page .fields > * { grid-row: var(--mr) / span var(--ms, 1); grid-column: 1 / -1; }
  .rl.m { display: block; }
  .lab .n, .field-name .n { position: static; margin-right: .5em; }
  .left { justify-self: end; align-self: center; margin: 0; font-size: 96px; }
  .info input, .info textarea { font-size: 16px; }
  /* once signed up or full: the sheet's lines 28 apart under each line of its type, one thing after
     another: what it means, its state, the QR and the price, the weathervane last */
  [data-state] .title { min-height: 0; }
  .sheet.done {
    --line: 28px; display: flex; flex-direction: column; gap: var(--line); margin: 48px calc(-1 * var(--gap)) 0; padding: 0 var(--gap) var(--line);
    background: repeating-linear-gradient(to bottom, var(--magenta) 0 1px, transparent 1px var(--line));
  }
  .sheet.done .rl { display: none; }
  .done > :not(.rl, .rooster), .done-pay > * { position: static; translate: none; width: auto; align-self: stretch; }
  .done :is(.done-left, .done-right) { line-height: var(--line); text-box: normal; text-align: left; }
  .done .bank-qr { position: static; width: calc(8 * var(--line)); }
  .done .fee { font-size: min(56px, calc((100cqi - 32px) / 4.9)); line-height: calc(2 * var(--line)); text-box: normal; }
  .done .vane { height: calc(14 * var(--line)); width: auto; align-self: center; }
  .bank-qr { height: calc(6 * var(--line) - 22px); padding: 12px; }
  .fee { font-size: min(72px, calc((100cqi - 32px) / 4.9)); }
  .send { padding: 40px 0 72px; }
  .cta { font-size: min(112px, calc((100cqi - 32px) / 4.3)); }
  .cta .ct::after { bottom: -8px; height: 1.5px; }
  .status { margin-top: 28px; }
}
@media (max-width: 599px) {
  .page { --f16: 12px; --f20: 16px; }
  .title { font-size: 48px; }
  :root main :is(p, span, a, label, dt, dd):not(.serif, .serif *, .display, .display *) { letter-spacing: -.01em; }
}
@media (pointer: coarse) and (min-width: 900px) { .info input, .info textarea { font-size: max(16px, var(--f20)); } }
@media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
/* the title made of the rooster's ice, as the landing page's titles are (title-shader.js): a canvas over
   the type, seen through its letters, the type going clear under it once it draws, still there to be
   read and selected */
.shading { position: relative; }
.title-shader { position: absolute; pointer-events: none; mask-size: 100% 100%; -webkit-mask-size: 100% 100%; mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; opacity: 0; transition: opacity 1.2s; }
.shaded > .title-shader { opacity: 1; }
.signup-title .line { transition: color 1.2s; }
.signup-title .line.shaded { color: transparent; }
.measuring .signup-title .line { transform: none !important; }
.intro .page > * { visibility: hidden; }
</style>
</head>
<body>
<main>
<div class="page">
  <nav class="bar" aria-label="Điều hướng">
    <span>© 2026</span>
    <a href="/">trang chủ</a>
  </nav>

  <h1 class="title signup-title display"><span class="line">sign up</span><span class="line serif">first season</span></h1>

  <!-- once signed up, or the places taken: a sheet of its own in the form's place (the script below) -->
  <section class="sheet done" data-done hidden aria-live="polite">
      <i class="rl top" style="--r: 1" aria-hidden="true"></i>
      <i class="rl" style="--r: 2" aria-hidden="true"></i>
      <i class="rl" style="--r: 3" aria-hidden="true"></i>
      <i class="rl" style="--r: 4" aria-hidden="true"></i>
      <i class="rl" style="--r: 5" aria-hidden="true"></i>
      <i class="rl" style="--r: 6" aria-hidden="true"></i>
      <i class="rl" style="--r: 7" aria-hidden="true"></i>
      <i class="rl" style="--r: 8" aria-hidden="true"></i>
      <i class="rl" style="--r: 9" aria-hidden="true"></i>
      <i class="rl" style="--r: 10" aria-hidden="true"></i>
      <i class="rl" style="--r: 11" aria-hidden="true"></i>
      <i class="rl" style="--r: 12" aria-hidden="true"></i>
      <i class="rl" style="--r: 13" aria-hidden="true"></i>
      <i class="rl" style="--r: 14" aria-hidden="true"></i>
      <i class="rl" style="--r: 15" aria-hidden="true"></i>
      <i class="rl" style="--r: 16" aria-hidden="true"></i>
      <i class="rl" style="--r: 17" aria-hidden="true"></i>
      <i class="rl" style="--r: 18" aria-hidden="true"></i>
      <i class="rl" style="--r: 19" aria-hidden="true"></i>
      <i class="rl" style="--r: 20" aria-hidden="true"></i>
      <i class="rl" style="--r: 21" aria-hidden="true"></i>
      <i class="rl" style="--r: 22" aria-hidden="true"></i>
    <p class="done-left" data-done-text></p>
    <p class="done-right" data-done-note></p>
    <img class="vane" src="/signup/vane.svg" alt="" width="598" height="849" data-vane>
    <div class="done-pay" data-done-pay hidden>
