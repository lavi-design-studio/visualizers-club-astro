---
// The landing page, as the static one in visualizers-club-prototypes/landing has it: its markup
// (src/partials/body.html, set as written: its type uses braces Astro would read as code), its styles
// (src/styles/landing.css) and its scripts (src/scripts), bundled; GSAP, Lenis and three from npm,
// where the static page took them from a CDN by an import map
import '../styles/landing.css';
import page from '../partials/body.html?raw';
import foot from '../partials/foot.html?raw';
const body = page.replace('<!--foot-->', foot);   // (the footer: src/partials/foot.html, shared with the sign-up page)
---
<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>The Visualizers Club</title>
<meta name="description" content="Khoá học về bố cục, chữ, màu và phân cấp thị giác. Chương trình được thực hiện bởi Lavi Design Studio.">
<meta name="theme-color" content="#000000">
<!-- the page's address and its card where a link to it is shared (Facebook, Zalo, X): the hero as
     it settles, 1200 x 630 -->
<link rel="canonical" href="https://visualizers.lavidesign.studio/">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<meta property="og:type" content="website">
<meta property="og:site_name" content="The Visualizers Club">
<meta property="og:locale" content="vi_VN">
<meta property="og:url" content="https://visualizers.lavidesign.studio/">
<meta property="og:title" content="The Visualizers Club">
<meta property="og:description" content="Khoá học về bố cục, chữ, màu và phân cấp thị giác. Chương trình được thực hiện bởi Lavi Design Studio.">
<meta property="og:image" content="https://visualizers.lavidesign.studio/og.jpg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="The Visualizers Club: tên khoá học màu magenta trên nền đen, dưới là bài của học viên">
<meta name="twitter:card" content="summary_large_image">
<script is:inline type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Course",
  "name": "The Visualizers Club",
  "description": "Khoá học về bố cục, chữ, màu và phân cấp thị giác. Học cách đưa ra quyết định thiết kế có lý do đằng sau.",
  "url": "https://visualizers.lavidesign.studio/",
  "inLanguage": "vi",
  "provider": { "@type": "Organization", "name": "Lavi Design Studio", "sameAs": ["https://www.facebook.com/Lavi.Designer", "https://www.instagram.com/lavi.uidesigner/"] },
  "offers": { "@type": "Offer", "category": "Paid", "price": "5000000", "priceCurrency": "VND" }
}
</script>
<script is:inline>
  // reached by the way between the pages (transition.js): opened under the magenta it was left on, till
  // its card is drawn over it (2.5 s at most)
  try {
    const t = JSON.parse(sessionStorage.getItem('vsc-pass') || 'null');
    if (t && Date.now() - t.at < 5000 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.classList.add('passing');
      setTimeout(() => document.documentElement.classList.remove('passing'), 2500);
    }
  } catch {}
</script>
<script is:inline>
  // the page opens on the loader (#loader) and the hero waits for its intro (motion.js); if they never
  // come, the page shows anyway. The loader starts at the top, so it can hand its pile to the hero
  document.documentElement.classList.add('loading');
  if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('intro');
  setTimeout(() => { document.documentElement.classList.remove('intro', 'loading'); document.documentElement.classList.add('hero-lines'); document.getElementById('loader')?.remove(); }, 9000);
</script>
<link rel="preload" href="/fonts/PPNeueWorld-SemiExtendedUltralight.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/PPMigra-ExtralightItalic.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/ABCAreal-Regular.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/ABCAreal-Medium.woff2" as="font" type="font/woff2" crossorigin>
<!-- Vercel Web Analytics: page views, no cookies; the script is served by Vercel itself once the
     project has Analytics on (deferred, so it never holds up the page) -->
<script is:inline>window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };</script>
<script is:inline defer src="/_vercel/insights/script.js"></script>
</head>
<body>
<Fragment set:html={body} />
<script>
  // the way to the sign-up page and back (transition.js), ready from the start
  import '../scripts/transition.js';
</script>
<script>
  // fetched once the first frame is painted (the loader up), so that paint never waits on them; a tab
  // in the background paints no frame, and fetches them a moment later all the same
  let go = () => { go = () => {}; import('../scripts/dither.js'); import('../scripts/fan.js'); import('../scripts/motion.js'); import('../scripts/ring.js'); import('../scripts/title-shader.js'); import('../scripts/ice.js'); };
  requestAnimationFrame(() => setTimeout(() => go()));
  setTimeout(() => go(), 250);
</script>
<script>
  // the links to the sign-up page (the hero's "đăng ký", the price's "giữ chỗ") say so once the nine
  // places are taken (paid or waiting to pay, as the sheet counts them): "hết chỗ", the price's plate
  // turned about; they still lead to the page, which says when the next class opens. Asked once the
  // page has loaded, so it never holds anything up
  import { SIGNUP_URL, CAP } from '../signup.js';
  const ask = () => fetch(SIGNUP_URL).then(r => r.json()).then(d => {
    if ((d.paid ?? d.taken ?? 0) + (d.wait ?? 0) < CAP) return;
    for (const a of document.querySelectorAll('a[data-signup]')) {
      const cta = a.closest('.price-cta');
      a.innerHTML = cta ? 'hết chỗ <span class="serif">(→)</span>' : 'hết chỗ';
      a.setAttribute('aria-label', 'Hết chỗ: xem trang đăng ký');
      if (cta) { cta.classList.add('full'); a.classList.add('btn-alt'); }
    }
  }).catch(() => {});
  if (document.readyState === 'complete') setTimeout(ask, 1000); else addEventListener('load', () => setTimeout(ask, 1000), { once: true });
</script>
</body>
</html>
